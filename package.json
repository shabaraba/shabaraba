{
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "node scripts/convert-toml-to-json.js",
    "dev": "./scripts/load-env.sh next dev",
    "prebuild": "node scripts/convert-toml-to-json.js && node scripts/build-article-index.js",
    "generate-og": "node scripts/generate-og-images.js || ./scripts/generate-og-images.sh",
    "generate-og-shell": "bash ./scripts/generate-og-images.sh",
    "build": "./scripts/load-env.sh sh -c 'node scripts/fetch-github-profile.js && node scripts/fetch-cover-images.js && node scripts/fetch-article-images.js && node scripts/fetch-article-og-images.js && pnpm run generate-og && next build && echo Build completed'",
    "build:incremental": "node scripts/build-article-index.js && next build",
    "start": "pnpm dlx serve@latest out",
    "postbuild": "next-sitemap",
    "analyze": "ANALYZE=true next build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@chakra-ui/icons": "^1.1.7",
    "@chakra-ui/react": "^2.10.10",
    "@chakra-ui/theme": "^3.4.6",
    "@chakra-ui/theme-utils": "^2.0.21",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iarna/toml": "^2.2.5",
    "@iconify/icons-simple-icons": "^1.2.74",
    "@iconify/react": "^5.2.1",
    "@meronex/icons": "^4.0.0",
    "@netlify/functions": "^0.11.1",
    "@netlify/plugin-nextjs": "^5.16.4",
    "@next/bundle-analyzer": "^12.3.7",
    "@notionhq/client": "^2.3.0",
    "@types/jsdom": "^20.0.1",
    "@types/react-sticky-el": "^1.0.7",
    "@types/react-syntax-highlighter": "^13.5.2",
    "@types/rss": "^0.0.29",
    "axios": "^1.20.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^1.3.8",
    "dotenv": "^16.6.1",
    "encoding": "^0.1.13",
    "framer-motion": "^6.5.1",
    "fs": "0.0.1-security",
    "gray-matter": "^4.0.3",
    "jsdom": "^20.0.3",
    "lodash": "^4.18.1",
    "net": "^1.0.2",
    "next": "^16.4.2",
    "next-absolute-url": "^1.2.2",
    "next-seo": "^5.15.0",
    "next-sitemap": "^3.1.55",
    "node-loader": "^2.1.0",
    "react": "^19.3.1",
    "react-code-blocks": "0.1.6",
    "react-dom": "^19.3.1",
    "react-icons": "^4.12.0",
    "react-intersection-observer": "^9.16.0",
    "react-markdown": "^10.1.0",
    "react-share": "^5.3.0",
    "react-sticky-el": "^2.1.1",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^14.0.3",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^15.0.2",
    "remark-parse": "^10.0.2",
    "server-only": "^0.0.1",
    "skia-canvas": "^4.0.0",
    "swr": "^1.3.0",
    "tls": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@netlify/esbuild": "^0.14.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.32.0",
    "feed": "^4.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
